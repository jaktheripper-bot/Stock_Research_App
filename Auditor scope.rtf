\f0\b \cf0 7. Security & Site Vulnerabilities
\f1\b0 \cell 
\pard\intbl\itap1\pardeftab720\partightenfactor0
\cf0 Protecting against DoS, IDOR, XSS, insecure headers, and data leaks.\cell 
\pard\intbl\itap1\pardeftab720\partightenfactor0
\cf0 \'95 
\f3\b\fs26 INV_SEC_HEADERS
\f1\b0\fs24 : Validates CSP, X-Frame-Options, X-Content-Type-Options.\
\'95 
\f3\b\fs26 INV_SEC_COOKIE_FLAGS
\f1\b0\fs24 : Enforces 
\f2\fs26 HttpOnly
\f1\fs24 , 
\f2\fs26 Secure
\f1\fs24 , 
\f2\fs26 SameSite
\f1\fs24 .\
\'95 
\f3\b\fs26 INV_SEC_NO_STACKTRACE
\f1\b0\fs24 : Verifies 4xx/5xx responses never leak tracebacks or file paths.\
\'95 
\f3\b\fs26 INV_SEC_AUTH_SCOPE
\f1\b0\fs24 : Verifies authorization checks on private user resources.\cell \lastrow\row
